{
  "$schema": "https://opencode.ai/config.json",
  "commands": {
    "review": {
      "template": "Review the current uncommitted changes using `git diff`. If the diff is empty, read the latest commit. Focus on logical correctness, edge cases, and potential issues. Assume type checks already pass. You don't need to lint.'",
      "description": "Reviews uncommited code for best practices and potential issues",
      "model": "openai/gpt-6.1-sol",
    },
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
